### remove special characters from batdat_panel
```{r}
# create clean name function
clean_name <- function(x) {
  x %>%
    str_remove_all("[*#]") %>%
    str_squish() %>%
    stri_trans_general("Latin-ASCII") %>%
    str_to_lower()
}
```
```{r}
# use clean name on batdat_panel and torpedo_players
batdat_panel$Player <- clean_name(batdat_panel$Player)

batdat_panel$Player %>%
  head()
```
```{r}
# clean torpedo_player names
torpedo_players$Player <- clean_name(torpedo_players$Player)
torpedo_players$Player %>%
  head()
```
### Merge Datasets

```{r}
batdat_panel <- batdat_panel %>%
  mutate (Player) %>%
  left_join(
    torpedo_players %>%
      select(Player, Torpedo_2025),
    by = "Player"
  ) %>%
  mutate(
    Torpedo_2025 = replace_na(Torpedo_2025, 0)
  )
```

## Sort players with mutiple teams and combine

```{r}
batdat_clean <- batdat_panel %>%
  group_by(Season, `Player-additional`) %>%
  filter(
    if (any(grepl("^[0-9]+TM$", Team))) {
      grepl("^[0-9]+TM$", Team)
    } else {
      TRUE
    }
  ) %>%
  ungroup()
```

```{r}
sum(batdat_clean$Torpedo_2025)
```



